rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Hospitals collection
    match /hospitals/{hospitalId} {
      allow read: if true;
      allow write: if isSignedIn();

      match /counters/opCounter {
        allow read, write: if isSignedIn();
      }
    }

    // Staff collection
    match /staff/{staffId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Patients collection (allows patient self-registration and staff management)
    match /patients/{patientId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn();
    }

    // patientsByPhone index collection (phone number uniqueness index)
    match /patientsByPhone/{phone} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Sessions collection (visit lifecycle)
    match /sessions/{sessionId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn();
    }

    // Records collection (medical documents and vitals)
    match /records/{recordId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn();
    }
  }
}
